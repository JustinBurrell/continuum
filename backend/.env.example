# Server Configuration
PORT=5001
NODE_ENV=development

# MongoDB Configuration
# Test (local dev): point to the 'test' database
MONGODB_URI=mongodb+srv://<username>:<password>@continuum-dev.iygdp9l.mongodb.net/test?appName=continuum-dev
# Production: swap in 'prod' as the database name
# MONGODB_URI=mongodb+srv://<username>:<password>@continuum-dev.iygdp9l.mongodb.net/prod?appName=continuum-dev

# JWT Authentication
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=1d

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5001/api/auth/google/callback

# Groq AI (Llama 3.1)
GROQ_API_KEY=your-groq-api-key

# Cloudinary (Resume PDF and Note Doc uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Resend (Password Reset Emails)
RESEND_API_KEY=your-resend-api-key

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Redis (optional — enables server-side caching and per-user AI rate limiting)
# REDIS_URL=redis://localhost:6379

# Google Token Encryption (optional — AES-256-GCM key for Google OAuth tokens at rest)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# GOOGLE_TOKEN_ENCRYPTION_KEY=your-64-char-hex-key

# Sentry (optional — error monitoring)
# SENTRY_DSN=https://your-dsn@sentry.io/your-project-id
