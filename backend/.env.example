# Server Configuration
PORT=5001
NODE_ENV=development

# MongoDB Configuration
# Test (local dev): point to the 'test' database
MONGODB_URI=mongodb+srv://<username>:<password>@continuum-dev.iygdp9l.mongodb.net/test?appName=continuum-dev
# Production: swap in 'prod' as the database name
# MONGODB_URI=mongodb+srv://<username>:<password>@continuum-dev.iygdp9l.mongodb.net/prod?appName=continuum-dev

# JWT Authentication
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=1d

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5001/api/auth/google/callback

# Google Picker (used by the Android WebView picker-page endpoint)
# API key: same value as VITE_GOOGLE_API_KEY in web/.env
#   Add your backend domain to the key's HTTP referrer restrictions:
#   - dev:  http://10.0.2.2:5001/*  (Android emulator host alias)
#   - prod: https://api.usecontinuum.dev/*
GOOGLE_PICKER_API_KEY=your-google-picker-api-key
# App ID: numeric Google Cloud project number
#   Find at: Cloud Console → Home → Project number
#   (also visible in Drive API errors: "app <NUMBER> read access")
GOOGLE_APP_ID=your-project-number

# Groq AI (Llama 3.1)
GROQ_API_KEY=your-groq-api-key

# Cloudinary (Resume PDF and Note Doc uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Resend (Password Reset Emails)
RESEND_API_KEY=your-resend-api-key

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Redis — JWT revocation + per-user AI rate limiting
# Not used for list/CRUD caching (MongoDB is fast enough at this scale).
# Optional locally — without it the app runs fine, AI rate limits are just not enforced.
#
# Setup (Mac):
#   brew install redis
#   brew services start redis   # starts in background, survives restarts
#   redis-cli ping              # should print PONG
#
REDIS_URL=redis://localhost:6379

# Special Role Auto-Assignment (comma-separated emails)
# Users registering with these emails are automatically assigned the corresponding role.
# To add someone: update this value in Render, then run: node scripts/assign-special-tags.js
FOUNDER_EMAILS=
TEAM_EMAILS=

# Google Token Encryption (optional — AES-256-GCM key for Google OAuth tokens at rest)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# GOOGLE_TOKEN_ENCRYPTION_KEY=your-64-char-hex-key

# Sentry (optional — error monitoring)
# SENTRY_DSN=https://your-dsn@sentry.io/your-project-id

# PostHog (production only — do not set locally; analytics are disabled in dev)
POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxx
POSTHOG_HOST=https://us.i.posthog.com

# App version — Render injects RENDER_GIT_COMMIT automatically in production (no action needed).
# APP_VERSION is a manual override fallback; leave unset locally.
# APP_VERSION=
