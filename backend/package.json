{
  "name": "backend",
  "version": "1.0.0",
  "description": "Continuum backend API server",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "jest --runInBand --forceExit",
    "test:watch": "jest --watch --runInBand",
    "start:e2e": "node tests/e2e/server.js"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/jest/**/*.test.js"
    ],
    "testTimeout": 30000,
    "setupFiles": [
      "./tests/jest/setup.js"
    ],
    "moduleNameMapper": {
      "^cloudinary$": "<rootDir>/tests/jest/__mocks__/cloudinary.js",
      "^resend$": "<rootDir>/tests/jest/__mocks__/resend.js",
      "^firebase-admin$": "<rootDir>/tests/jest/__mocks__/firebase-admin.js"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@sentry/node": "^10.46.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "anki-apkg-export": "^4.0.3",
    "axios": "^1.18.1",
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.2.2",
    "cloudinary": "^2.9.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "firebase-admin": "^13.10.0",
    "geoip-lite": "^1.4.10",
    "google-auth-library": "^10.6.2",
    "googleapis": "^171.4.0",
    "groq-sdk": "^0.37.0",
    "helmet": "^8.1.0",
    "ical-generator": "^11.0.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "marked": "^15.0.12",
    "mongo-sanitize": "^1.1.0",
    "mongodb": "^7.0.0",
    "mongoose": "^9.1.4",
    "multer": "^2.1.0",
    "node-cron": "^4.2.1",
    "officeparser": "^7.2.3",
    "p-queue": "^6.6.2",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pdf-parse": "^2.4.5",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "posthog-node": "^5.21.2",
    "puppeteer": "^24.43.1",
    "redis": "^5.11.0",
    "resend": "^6.9.2",
    "sanitize-html": "^2.17.1",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "ua-parser-js": "^2.0.10",
    "youtube-transcript-plus": "^2.0.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.3.0",
    "mongodb-memory-server": "^11.0.1",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2"
  }
}
