    {
      "name": "5. Email Verification",
      "item": [
        {
          "name": "Send Verification Email",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// 200 expected \u2014 backend sends the email via Resend.",
                  "// Copy the token from your inbox or backend log and set",
                  "// {{verificationToken}} in the environment before running 'Verify Email'.",
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('success is true', () => {",
                  "    pm.expect(pm.response.json().success).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/send-verification",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "send-verification"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Verify Email",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Prereq: set {{verificationToken}} from the email link (?token=...).",
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('success is true', () => {",
                  "    pm.expect(pm.response.json().success).to.be.true;",
                  "});",
                  "pm.test('message confirms verification', () => {",
                  "    pm.expect(pm.response.json().message).to.include('verified');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/verify-email?token={{verificationToken}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "verify-email"
              ],
              "query": [
                {
                  "key": "token",
                  "value": "{{verificationToken}}"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "[Error] Send Verification \u2014 Already Verified",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// After verifying above, a second send should return 400.",
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('error mentions already verified', () => {",
                  "    pm.expect(pm.response.json().error).to.include('already verified');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/send-verification",
