    {
      "name": "3. Activity Feed (API-24)",
      "item": [
        {
          "name": "Get Activity Feed — Default",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    if (json.feed && json.feed.length > 0) {",
                  "        pm.environment.set('activityId', json.feed[0]._id);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/activity",
              "host": ["{{baseUrl}}"],
              "path": ["api", "activity"]
            }
          },
          "response": []
        },
        {
          "name": "Get Activity Feed — Paginated (limit=5, offset=0)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/activity?limit=5&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["api", "activity"],
              "query": [
                { "key": "limit",  "value": "5" },
                { "key": "offset", "value": "0" }
