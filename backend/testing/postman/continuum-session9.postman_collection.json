    "name": "Continuum — Session 9",
    "description": "API-29: Server-Side Search — upgrade all client-side search to server-side API search.\n\nCovers: GET /api/tasks/shared?search=, GET /api/flashcard-sets/shared?search=, GET /api/friends?search=, GET /api/conversations?search=, GET /api/conversations/:id/messages?search=, GET /api/activity?search=.\n\nRun order: 1. Login → 2. Shared Tasks Search → 3. Shared Flashcard Sets Search → 4. Friends Search → 5. Conversations Search → 6. Messages Search → 7. Activity Search.\ntoken, sharedTaskId, flashcardSetId, conversationId, and activityId must be populated (from prior sessions or manually set in environment).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{token}}", "type": "string" }
    ]
  },
  "item": [
    {
      "name": "1. Login",
      "item": [
        {
          "name": "Login — User A",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    pm.environment.set('token', json.token);",
                  "    pm.environment.set('userId', json.user._id);",
                  "    pm.environment.set('refreshToken', json.refreshToken);",
                  "    pm.test('Login successful', () => pm.expect(json.token).to.be.a('string'));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"Password123!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Shared Tasks Search",
      "item": [
        {
          "name": "Get all shared tasks (no filter)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Returns tasks array', () => pm.expect(json.tasks).to.be.an('array'));",
                  "if (json.tasks.length > 0) {",
                  "    pm.environment.set('sharedTaskId', json.tasks[0]._id);",
                  "    pm.test('Task has _id', () => pm.expect(json.tasks[0]._id).to.be.a('string'));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tasks/shared",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks", "shared"]
            }
          },
          "response": []
