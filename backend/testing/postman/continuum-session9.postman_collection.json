                  "const json = pm.response.json();",
                  "pm.test('Returns tasks array', () => pm.expect(json.tasks).to.be.an('array'));",
                  "pm.test('All results contain search term (case-insensitive)', () => {",
                  "    json.tasks.forEach(t => {",
