    {
      "name": "4. Mark Activity Seen (API-32)",
      "item": [
        {
          "name": "Mark Activity Seen",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Returns success', () => pm.expect(json.success).to.equal(true));",
                  "pm.environment.set('lastViewedActivityAt', new Date().toISOString());"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/activity/mark-seen",
              "host": ["{{baseUrl}}"],
              "path": ["api", "activity", "mark-seen"]
            }
          },
          "response": []
        },
        {
          "name": "Verify lastViewedActivityAt updated (GET /me)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('lastViewedActivityAt is set', () => pm.expect(json.user.lastViewedActivityAt).to.not.equal(null));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            }
          },
          "response": []
