              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Returns feed', () => pm.expect(json.feed).to.be.an('array'));",
                  "pm.test('Total is a number', () => pm.expect(json.total).to.be.a('number'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/activity?since={{lastViewedActivityAt}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "activity"],
              "query": [{ "key": "since", "value": "{{lastViewedActivityAt}}" }]
