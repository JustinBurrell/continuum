        {
          "name": "Post Top-Level Comment",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Comment created', () => pm.expect(pm.response.code).to.equal(201));",
                  "const json = pm.response.json();",
                  "pm.environment.set('parentCommentId', json.comment._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"targetType\": \"note\",\n  \"targetId\": \"{{noteId}}\",\n  \"content\": \"Top level comment for reply testing.\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/comments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "comments"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Reply Happy Path",
      "item": [
        {
          "name": "Post Reply — valid parentId",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Reply created with 201', () => pm.expect(pm.response.code).to.equal(201));",
                  "const json = pm.response.json();",
                  "pm.test('parentId is set correctly', () => {",
                  "    pm.expect(json.comment.parentId).to.equal(pm.environment.get('parentCommentId'));",
                  "});",
                  "pm.environment.set('replyCommentId', json.comment._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"targetType\": \"note\",\n  \"targetId\": \"{{noteId}}\",\n  \"content\": \"This is a reply to the top-level comment.\",\n  \"parentId\": \"{{parentCommentId}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/comments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "comments"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "4. GET Flat List with Replies",
      "item": [
        {
          "name": "GET Comments — flat list includes replies",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.expect(pm.response.code).to.equal(200));",
                  "const json = pm.response.json();",
                  "pm.test('At least 2 comments returned', () => pm.expect(json.comments.length).to.be.at.least(2));",
                  "const reply = json.comments.find(c => c.parentId !== null);",
                  "pm.test('Flat list contains a reply with parentId', () => pm.expect(reply).to.exist);",
                  "pm.test('Reply parentId matches top-level comment', () => {",
                  "    pm.expect(reply.parentId).to.equal(pm.environment.get('parentCommentId'));",
                  "});",
                  "pm.test('Comments sorted oldest first', () => {",
                  "    const times = json.comments.map(c => new Date(c.createdAt).getTime());",
                  "    for (let i = 1; i < times.length; i++) {",
                  "        pm.expect(times[i]).to.be.at.least(times[i - 1]);",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/comments/note/{{noteId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "comments", "note", "{{noteId}}"]
            }
          },
          "response": []
        }
      ]
    },
    {
