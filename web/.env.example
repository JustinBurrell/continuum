VITE_API_URL=http://localhost:5001

# Google Picker API key — required for Google Drive import
# Create at: Google Cloud Console → APIs & Services → Credentials → + Create Credentials → API key
# Restrict to: Google Picker API + HTTP referrers (localhost:5173/*, your prod domain)
VITE_GOOGLE_API_KEY=your_google_api_key_here

# Sentry (optional — error monitoring)
# VITE_SENTRY_DSN=https://your-dsn@sentry.io/your-project-id

# PostHog (optional — product analytics and session replay)
# VITE_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxx
# VITE_POSTHOG_HOST=https://us.i.posthog.com

# App version — set to git SHA at build time for release correlation in PostHog/Sentry
# VITE_APP_VERSION=local
